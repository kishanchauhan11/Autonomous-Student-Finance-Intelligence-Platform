@page
@model IndexModel
@{
    ViewData["Title"] = "Home Page";
}

<!-- ───────────────────────────────────────────────────────────
     STUDENT VIEWS
     ─────────────────────────────────────────────────────────── -->

<!-- VIEW: STUDENT DASHBOARD -->
<div id="view-dashboard" class="view-content">
    <div class="page-header" style="margin-bottom: 24px;">
        <div>
            <h1 class="display-title">Student Finance Dashboard</h1>
            <p class="subtitle" id="student-profile-program">B.Tech Computer Science & Engineering  ·  Student ID: STU-2021-4892  ·  Sem 7</p>
        </div>
        <div>
            <span class="badge approved" style="padding: 6px 12px;">Keycloak Verified</span>
        </div>
    </div>

    <!-- KPI GRID -->
    <div class="kpi-grid" style="margin-bottom: 32px;">
        <div class="kpi-card">
            <span class="kpi-label">Outstanding Balance</span>
            <span class="kpi-value mono" id="kpi-fees-due">₹ 0.00</span>
            <span class="kpi-trend negative"><i class="ph-warning"></i> Due Immediately</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Total Fees Paid</span>
            <span class="kpi-value mono" id="kpi-fees-paid">₹ 0.00</span>
            <span class="kpi-trend positive"><i class="ph-check-circle"></i> Sync'd with ERP</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Scholarships Applied</span>
            <span class="kpi-value mono" id="kpi-scholarship">₹ 0.00</span>
            <span class="kpi-trend positive"><i class="ph-tag"></i> 1 Active Waiver</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Pending Refund</span>
            <span class="kpi-value mono" id="kpi-refund-pending">₹ 0.00</span>
            <span class="kpi-trend positive"><i class="ph-clock"></i> In Verification</span>
        </div>
    </div>

    <!-- MAIN TWO-COLUMN LAYOUT -->
    <div class="row-cols-2">
        <div class="card">
            <div class="card-header">
                <span class="card-title">Recent Transactions</span>
                <button class="btn btn-secondary btn-sm" onclick="switchTab('payments')">View Ledger</button>
            </div>
            <div class="table-container">
                <table class="table-monochrome">
                    <thead>
                        <tr>
                            <th>Transaction ID</th>
                            <th>Date</th>
                            <th>Description</th>
                            <th style="text-align: right;">Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="dashboard-txns-body">
                        <!-- Loaded dynamically -->
                    </tbody>
                </table>
            </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 24px;">
            <div class="card" style="border-left: 3px solid #000;">
                <div class="card-header"><span class="card-title">Billing & Deadlines</span></div>
                <div class="card-body">
                    <p style="font-size: 13.5px; margin-bottom: 16px;">
                        The Semester 7 Tuition invoices have been posted. Late fees of <strong>₹ 500.00 per day</strong> are applicable if fees are not cleared within 15 days of the start of the semester.
                    </p>
                    <div style="padding: 12px; background-color: var(--color-bg-base); border-radius: var(--radius-md); margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div style="font-size: 11px; text-transform: uppercase; color: var(--color-text-tertiary);">Current Due</div>
                            <div class="mono" id="deadlines-balance" style="font-size: 18px; font-weight: 700;">₹ 0.00</div>
                        </div>
                        <button class="btn btn-primary btn-sm" onclick="switchTab('payments')">Pay Now</button>
                    </div>
                    <div style="font-size: 11px; color: var(--color-text-tertiary); display: flex; align-items: center; gap: 6px;">
                        <i class="ph-info"></i> For SWIFT or overseas bank details, use the International tab.
                    </div>
                </div>
            </div>
            
            <div class="card">
                <div class="card-header"><span class="card-title">Quick Actions</span></div>
                <div class="card-body" style="display: flex; flex-direction: column; gap: 10px; padding: 16px 24px;">
                    <a class="btn btn-secondary" onclick="switchTab('loans')" style="justify-content: flex-start;"><i class="ph-file-text"></i> Get Loan Demand Letter</a>
                    <a class="btn btn-secondary" onclick="switchTab('refunds')" style="justify-content: flex-start;"><i class="ph-arrow-counter-clockwise"></i> Track Refund Pipeline</a>
                    <a class="btn btn-secondary" onclick="toggleChatPanel()" style="justify-content: flex-start; background-color: var(--color-bg-base);"><i class="ph-chat-circle-text"></i> Talk to Finance Assistant</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- VIEW: FEE PAYMENTS & LEDGER -->
<div id="view-payments" class="view-content" style="display: none;">
    <div class="page-header" style="margin-bottom: 24px;">
        <div>
            <h1 class="display-title">Fee Invoice & Ledger</h1>
            <p class="subtitle">Detailed breakdown of accounts billed, waivers applied, and historical receipts.</p>
        </div>
    </div>

    <!-- LEDGER CARDS -->
    <div class="kpi-grid" style="margin-bottom: 32px; grid-template-columns: repeat(3, 1fr);">
        <div class="kpi-card">
            <span class="kpi-label">Total Billed Fees</span>
            <span class="kpi-value mono" id="pay-summary-billed">₹ 0.00</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Total Credited/Paid</span>
            <span class="kpi-value mono" id="pay-summary-paid">₹ 0.00</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Net Balance Due</span>
            <span class="kpi-value mono" id="pay-summary-due" style="font-weight: 700;">₹ 0.00</span>
        </div>
    </div>

    <!-- INVOICE/TRANSACTION TABLE -->
    <div class="card">
        <div class="card-header"><span class="card-title">Fee Account Ledger</span></div>
        <div class="table-container">
            <table class="table-monochrome">
                <thead>
                    <tr>
                        <th>Invoice / Reference ID</th>
                        <th>Billing Item / Category</th>
                        <th>Posting Date</th>
                        <th style="text-align: right;">Billed Amount</th>
                        <th style="text-align: right;">Paid Amount</th>
                        <th style="text-align: right;">Balance</th>
                        <th>Status</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody id="payments-table-body">
                    <!-- Loaded dynamically -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- VIEW: LOAN DEMAND LETTERS -->
<div id="view-loans" class="view-content" style="display: none;">
    <div class="page-header" style="margin-bottom: 24px;">
        <div>
            <h1 class="display-title">Education Loan Demand Letters</h1>
            <p class="subtitle">Request and download digitally certified tuition fee estimates for bank education loans.</p>
        </div>
    </div>

    <div class="row-cols-2">
        <div class="card">
            <div class="card-header"><span class="card-title">Generated Letters</span></div>
            <div class="table-container">
                <table class="table-monochrome">
                    <thead>
                        <tr>
                            <th>Document ID</th>
                            <th>Academic Program</th>
                            <th>Target Bank</th>
                            <th style="text-align: right;">Certified Amount</th>
                            <th>Certification Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="loans-table-body">
                        <!-- Loaded dynamically -->
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><span class="card-title">Generate New Letter</span></div>
            <div class="card-body">
                <form id="loan-creation-form" onsubmit="requestLoanLetter(event)">
                    <div class="form-group">
                        <label class="form-label">Target Financial Institution <span class="required">*</span></label>
                        <select class="form-select" id="loan-form-bank" required>
                            <option value="State Bank of India">State Bank of India</option>
                            <option value="HDFC Bank">HDFC Bank</option>
                            <option value="ICICI Bank">ICICI Bank</option>
                            <option value="Punjab National Bank">Punjab National Bank</option>
                            <option value="Axis Bank">Axis Bank</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Fee Breakdown Structure <span class="required">*</span></label>
                        <select class="form-select" id="loan-form-term" required>
                            <option value="current">Current Semester Only</option>
                            <option value="next">Next Academic Semester</option>
                            <option value="full">Full Academic Year (2 Semesters)</option>
                        </select>
                    </div>
                    <div style="font-size: 11px; color: var(--color-text-tertiary); margin-bottom: 20px;">
                        ✓ Generates a certified estimate including Tuition, Lab, Hostel and Exam fees, signed digitally by the Registrar. Valid for 90 days.
                    </div>
                    <button type="submit" class="btn btn-primary" style="width: 100%;">Request Estimate</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- VIEW: REFUND TRACKER -->
<div id="view-refunds" class="view-content" style="display: none;">
    <div class="page-header" style="margin-bottom: 24px;">
        <div>
            <h1 class="display-title">Fee Refund Tracking Pipeline</h1>
            <p class="subtitle">Submit refund requests and track processing stages in real-time.</p>
        </div>
    </div>

    <!-- Active progress stepper (monochrome) -->
    <div class="card" style="margin-bottom: 32px;">
        <div class="card-header"><span class="card-title">Active Refund Progress Tracker</span></div>
        <div class="card-body" id="active-refund-stepper-container">
            <!-- Loaded dynamically -->
        </div>
    </div>

    <div class="row-cols-2">
        <div class="card">
            <div class="card-header"><span class="card-title">Historical Refund Requests</span></div>
            <div class="table-container">
                <table class="table-monochrome">
                    <thead>
                        <tr>
                            <th>Request ID</th>
                            <th>Description</th>
                            <th>Submission Date</th>
                            <th style="text-align: right;">Amount</th>
                            <th>Current Stage</th>
                            <th>Estimated SLA</th>
                        </tr>
                    </thead>
                    <tbody id="refunds-table-body">
                        <!-- Loaded dynamically -->
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><span class="card-title">File Refund Request</span></div>
            <div class="card-body">
                <form id="refund-creation-form" onsubmit="fileNewRefund(event)">
                    <div class="form-group">
                        <label class="form-label">Refund Category / Description <span class="required">*</span></label>
                        <input type="text" class="form-input" id="refund-form-desc" placeholder="e.g. Double payment refund sem 7" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Refund Amount Required <span class="required">*</span></label>
                        <div class="input-currency-wrapper">
                            <span class="input-currency-prefix">₹</span>
                            <input type="number" class="form-input" id="refund-form-amount" placeholder="0.00" required>
                        </div>
                        <span class="form-helper">Requests exceeding ₹ 1,00,000.00 trigger manual Director verification.</span>
                    </div>
                    <button type="submit" class="btn btn-primary" style="width: 100%;">Submit Refund Request</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- VIEW: INTERNATIONAL FINANCE -->
<div id="view-international" class="view-content" style="display: none;">
    <div class="page-header" style="margin-bottom: 24px;">
        <div>
            <h1 class="display-title">International Student Payments</h1>
            <p class="subtitle">Guidelines, exchange mechanisms, and SWIFT wiring details for international fees.</p>
        </div>
    </div>

    <div class="row-cols-2">
        <div class="card">
            <div class="card-header"><span class="card-title">Official Wire Transfer Bank Coordinates</span></div>
            <div class="card-body">
                <p style="margin-bottom: 20px; font-size: 14px;">
                    Please provide these exact banking coordinates to your financial institution when initiating overseas bank wire transfers.
                </p>
                
                <table class="table-monochrome" style="border: 1px solid var(--color-border); margin-bottom: 24px;">
                    <tbody>
                        <tr>
                            <td><strong>Receiving Institution</strong></td>
                            <td>Institutional Trust Bank Ltd.</td>
                        </tr>
                        <tr>
                            <td><strong>Branch Code & Name</strong></td>
                            <td>University Campus Main Branch</td>
                        </tr>
                        <tr>
                            <td><strong>Bank SWIFT Code / BIC</strong></td>
                            <td class="mono font-semibold" style="font-size: 14px;">ITB1NDIA33B</td>
                        </tr>
                        <tr>
                            <td><strong>Account Number</strong></td>
                            <td class="mono">9876543210</td>
                        </tr>
                        <tr>
                            <td><strong>Remittance Currency</strong></td>
                            <td>Indian Rupee (INR) Equivalent</td>
                        </tr>
                        <tr>
                            <td><strong>Required Reference Tag</strong></td>
                            <td class="mono font-semibold" style="text-decoration: underline;">Student ID (e.g. STU-2021-4892)</td>
                        </tr>
                    </tbody>
                </table>
                
                <div style="padding: 16px; background-color: var(--color-bg-base); border-radius: var(--radius-md);">
                    <div style="font-weight: 700; margin-bottom: 8px; font-size: 12px; text-transform: uppercase;">⚠️ CRITICAL COMPLIANCE NOTICE:</div>
                    <div style="font-size: 12px; color: var(--color-text-secondary); line-height: 1.5;">
                        You MUST quote your Student ID exactly in the SWIFT remittance/reference field. Failing to specify the reference will cause payment reconciliation exceptions, delays, or return of funds.
                    </div>
                </div>
            </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 24px;">
            <div class="card">
                <div class="card-header"><span class="card-title">Flywire & Digital Channels</span></div>
                <div class="card-body">
                    <p style="font-size: 13.5px; margin-bottom: 16px; line-height: 1.5;">
                        Students from USA, UK, EU, and Canada can pay in local currencies (USD, GBP, EUR) via Flywire or Western Union Business Solutions for faster clearance and reduced forex fees.
                    </p>
                    <button class="btn btn-secondary" onclick="alert('Redirecting to Flywire Student Portal...')" style="width: 100%; margin-bottom: 10px;">
                        <i class="ph-globe"></i> Pay via Flywire Portal
                    </button>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><span class="card-title">Forex & Processing Charges</span></div>
                <div class="card-body">
                    <table style="width: 100%; font-size: 13px; border-collapse: collapse;">
                        <tr style="border-bottom: 1px solid var(--color-border-light);">
                            <td style="padding: 8px 0;">University Processing Fee</td>
                            <td class="mono" style="text-align: right;">2.50%</td>
                        </tr>
                        <tr style="border-bottom: 1px solid var(--color-border-light);">
                            <td style="padding: 8px 0;">Clearance SLA</td>
                            <td style="text-align: right;">3-5 Working Days</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 0;">Late Fee Grace Extension</td>
                            <td style="text-align: right;">+5 Days allowed</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- ───────────────────────────────────────────────────────────
     ADMIN / ACCOUNTS OFFICE VIEWS
     ─────────────────────────────────────────────────────────── -->

<!-- VIEW: RECONCILIATION EXCEPTIONS -->
<div id="view-reconciliation" class="view-content" style="display: none;">
    <div class="page-header" style="margin-bottom: 24px;">
        <div>
            <h1 class="display-title">Payment Reconciliation exceptions</h1>
            <p class="subtitle">Manage gateway synchronization discrepancies and ERP ledger matching mismatches.</p>
        </div>
    </div>

    <!-- KPI Block -->
    <div class="kpi-grid" style="margin-bottom: 32px; grid-template-columns: repeat(3, 1fr);">
        <div class="kpi-card" id="kpi-exceptions-card">
            <span class="kpi-label">Active Discrepancies</span>
            <span class="kpi-value mono" id="kpi-exceptions">0</span>
            <span class="kpi-trend negative"><i class="ph-warning"></i> Action Required</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Daily Reconciliation Status</span>
            <span class="kpi-value mono" style="font-size:22px;">98.2%</span>
            <span class="kpi-trend positive"><i class="ph-check-circle"></i> Sync Engine Normal</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Gateway Webhooks</span>
            <span class="kpi-value mono" style="font-size:22px;">100% Ok</span>
            <span class="kpi-trend positive"><i class="ph-pulse"></i> Razorpay & Stripe Up</span>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><span class="card-title">Mismatched Exception Logs</span></div>
        <div class="table-container">
            <table class="table-monochrome">
                <thead>
                    <tr>
                        <th>Exception ID</th>
                        <th>Gateway Txn ID</th>
                        <th>Student ID</th>
                        <th style="text-align: right;">Expected (Gateway)</th>
                        <th style="text-align: right;">Received (ERP)</th>
                        <th style="text-align: right;">Delta Mismatch</th>
                        <th>Gateway Source</th>
                        <th>Sync Status</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody id="reconciliation-table-body">
                    <!-- Loaded dynamically -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- VIEW: APPROVALS QUEUE -->
<div id="view-approvals" class="view-content" style="display: none;">
    <div class="page-header" style="margin-bottom: 24px;">
        <div>
            <h1 class="display-title">Finance Officer Approvals Queue</h1>
            <p class="subtitle">Review and authorize high-value refunds, tuition waivers, and manual escalations.</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><span class="card-title">Pending Authorization Tasks</span></div>
        <div class="table-container">
            <table class="table-monochrome">
                <thead>
                    <tr>
                        <th>Approval Task ID</th>
                        <th>Task Type / Description</th>
                        <th>Requester (Student ID)</th>
                        <th style="text-align: right;">Target Amount</th>
                        <th>Risk Priority</th>
                        <th>Task Age</th>
                        <th>Approval Status</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="approvals-table-body">
                    <!-- Loaded dynamically -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- VIEW: ANALYTICS & REPORTS -->
<div id="view-analytics" class="view-content" style="display: none;">
    <div class="page-header" style="margin-bottom: 24px;">
        <div>
            <h1 class="display-title">Financial Analytics & Telemetry</h1>
            <p class="subtitle">Consolidated reports on collection rates, refund cycles, and outstanding debt aging.</p>
        </div>
    </div>

    <!-- Analytics KPIs -->
    <div class="kpi-grid" style="margin-bottom: 32px;">
        <div class="kpi-card">
            <span class="kpi-label">Gross Collection Sem 7</span>
            <span class="kpi-value mono" style="font-size: 22px;">₹ 4,82,90,000.00</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Total Outstanding Debt</span>
            <span class="kpi-value mono" style="font-size: 22px;">₹ 24,15,000.00</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Average Refund Age</span>
            <span class="kpi-value mono" style="font-size: 22px;">12.4 Hours</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">AI Resolution SLA</span>
            <span class="kpi-value mono" style="font-size: 22px;">94.8%</span>
        </div>
    </div>

    <div class="grid-2">
        <!-- Grayscale Chart Mock: Collections -->
        <div class="card">
            <div class="card-header"><span class="card-title">Fee Collections (Monthly Trend)</span></div>
            <div class="card-body" style="height: 260px; display: flex; flex-direction: column; justify-content: flex-end; gap: 16px;">
                <!-- Simulated monochrome bar chart using pure HTML/CSS -->
                <div style="display: flex; align-items: flex-end; justify-content: space-around; height: 180px; padding-bottom: 8px; border-bottom: 1.5px solid #000;">
                    <div style="display: flex; flex-direction: column; align-items: center; width: 48px;">
                        <div style="height: 60px; width: 28px; background-color: #E8E8E8; border: 1px solid #999;"></div>
                        <span class="mono" style="font-size: 10px; margin-top: 6px;">Jan</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; width: 48px;">
                        <div style="height: 90px; width: 28px; background-color: #D0D0D0; border: 1px solid #666;"></div>
                        <span class="mono" style="font-size: 10px; margin-top: 6px;">Feb</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; width: 48px;">
                        <div style="height: 140px; width: 28px; background-color: #6B6B6B; border: 1px solid #333;"></div>
                        <span class="mono" style="font-size: 10px; margin-top: 6px;">Mar</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; width: 48px;">
                        <div style="height: 165px; width: 28px; background-color: #0A0A0A; border: 1px solid #000;"></div>
                        <span class="mono" style="font-size: 10px; margin-top: 6px;">Apr</span>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: center; width: 48px;">
                        <div style="height: 120px; width: 28px; background-color: #999999; border: 1px solid #333;"></div>
                        <span class="mono" style="font-size: 10px; margin-top: 6px;">May</span>
                    </div>
                </div>
                <div style="font-size: 11px; color: var(--color-text-tertiary); text-align: center;">
                    Bar heights represent billing collections. Shading intensity represents payment volume.
                </div>
            </div>
        </div>

        <!-- Aging Debt Structure -->
        <div class="card">
            <div class="card-header"><span class="card-title">Outstanding Aging Debt Bracket</span></div>
            <div class="card-body">
                <table class="table-monochrome" style="border: 1px solid var(--color-border);">
                    <thead>
                        <tr>
                            <th>Age Bracket</th>
                            <th style="text-align: right;">Billed Amount</th>
                            <th>Waivers</th>
                            <th>Risk Assessment</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>0–15 Days</strong></td>
                            <td class="currency-cell mono">₹ 14,80,000.00</td>
                            <td>Waiver cleared</td>
                            <td><span class="badge pending">LOW</span></td>
                        </tr>
                        <tr>
                            <td><strong>16–30 Days</strong></td>
                            <td class="currency-cell mono">₹ 6,40,000.00</td>
                            <td>Grace granted</td>
                            <td><span class="badge pending">MEDIUM</span></td>
                        </tr>
                        <tr class="overdue">
                            <td><strong>31–60 Days</strong></td>
                            <td class="currency-cell mono">₹ 1,95,000.00</td>
                            <td>Portal blocked</td>
                            <td><span class="badge approved">HIGH</span></td>
                        </tr>
                        <tr class="overdue" style="font-weight: 700;">
                            <td><strong>&gt; 60 Days</strong></td>
                            <td class="currency-cell mono">₹ 1,00,000.00</td>
                            <td>Legal demand</td>
                            <td><span class="badge approved">HIGH</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

