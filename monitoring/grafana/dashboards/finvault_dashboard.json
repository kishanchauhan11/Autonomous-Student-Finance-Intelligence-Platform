{
  "uid": "finvault-main-v1",
  "title": "FinVault \u2014 Student Finance Intelligence Platform",
  "description": "Real-time monitoring: AI agents, payment pipeline, refund SLA, Kafka events",
  "tags": [
    "finvault",
    "finance",
    "ai",
    "kafka"
  ],
  "timezone": "Asia/Kolkata",
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Active Students Online",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "finvault_active_sessions_total",
          "legendFormat": "Active Students Online"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "AI Requests / min",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "rate(finvault_ai_requests_total[1m])",
          "legendFormat": "AI Requests / min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
